        RPCopy_Toggle()
    </Binding>
    <Binding name="RPCOPY_QUICK" category="ADDONS">
        RPCopy_QuickCopy()
    </Binding>
    <Binding name="RPCOPY_CAPTURE" category="ADDONS">
        RPCopy_CaptureTarget()
